# Backend
TRAFFIC_MODE=mock
VIDEO_SOURCE=0
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.35
SERIAL_MODE=mock
SERIAL_PORT=COM5
SERIAL_BAUD=115200
MIN_GREEN=8
MAX_GREEN=45
STARTUP_LOST_TIME=2.0
SATURATION_FLOW_PER_LANE=0.5
ARRIVAL_RATE_FRACTION=0.2
EFFECTIVE_LANES=1
MIN_ELIGIBLE_DEMAND=0.5
MAX_PRIORITY_AGE_SECONDS=90
DEMAND_MEDIAN_SAMPLES=5
DEMAND_LAMBDA_UP=0.5
DEMAND_LAMBDA_DOWN=0.2
YELLOW_SECONDS=3
ALL_RED_SECONDS=1
FRONTEND_ORIGINS=http://localhost:5173

# SUMO / TraCI integration (opt-in)
# Set SUMO_ENABLED=true to drive the SUMO simulation alongside ESP32.
# SUMO_HOME must be set to your SUMO 1.27.1 installation directory.
SUMO_ENABLED=false
# Default resolves to <project_root>/sumo/cross.sumocfg automatically.
# Override if you move the config file:
# SUMO_CFG=C:/path/to/sumo/cross.sumocfg
SUMO_GUI=false
SUMO_STEP_LENGTH=1.0

